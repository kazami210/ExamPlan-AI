# Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console)
# Hệ thống hỗ trợ đọc GOOGLE_CLIENT_ID hoặc các tiền tố:
# VITE_GOOGLE_CLIENT_ID, NEXT_PUBLIC_GOOGLE_CLIENT_ID, REACT_APP_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Gemini API Key (Miễn phí từ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
